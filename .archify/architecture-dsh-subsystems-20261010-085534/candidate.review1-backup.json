  "cards": [
    {
      "dot": "cyan",
      "title": "插件化组合",
      "items": [
        "一切皆 Cordis 插件：模型适配、工具、会话日志、agent loop 本身都可从配置替换",
        "profile 叠加 bundle 与 cordis.patch.yml，层层可 patch",
        "dsh-base 是 web/headless/sdk/acp 的公共首层"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent Loop 与会话日志",
      "items": [
        "turn = 零或多个 step；step = 一次模型请求 + 它调用的工具",
        "会话日志是模型上下文的唯一来源：model-visible ⟺ logged",
        "live agent/* 事件负责观测与拦截，durable session 事件负责重放"
      ]
    },
    {
      "dot": "amber",
      "title": "能力 seam 与执行世界",
      "items": [
        "能力 seam 由 Service Definition / Provider / Consumer 三角色构成",
        "fs 与 subprocess 共享一个执行世界：整体切到远程沙箱无需 provider 分叉",
        "subagent 到 Agent Teams 都经同一接口协作"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与约束",
      "items": [
        "守卫管线：pre-execute waterfall → 单调守卫 → execute / post-execute",
        "ctx.approval 一次性审批：缺席或无法应答即拒绝",
        "沙箱后端 bwrap / Landlock / Seatbelt 在 spawn 前封装 argv"
      ]
    }
  ]
