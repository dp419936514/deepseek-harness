  "cards": [
    {
      "dot": "cyan",
      "title": "Turn 与 Step",
      "items": [
        "turn 在首批输入被认领前开启，无欠账即关闭",
        "step = 一次模型请求 + 它调用的工具",
        "工具另欠请求或 next-step 输入到达 → 认领并进入下一 step"
      ]
    },
    {
      "dot": "amber",
      "title": "等待与恢复",
      "items": [
        "审批是一次性询问：缺席或无法应答即拒绝",
        "请求失败经 agent/request-error 返回 retry 才重试",
        "重试不重复组装、pre-step 或用户准入"
      ]
    },
    {
      "dot": "rose",
      "title": "终态",
      "items": [
        "拒绝或空首批：turn 不含 step 直接关闭",
        "取消时已流式交付的文本保留",
        "未分发的工具调用得到 ABORTED_BEFORE_DISPATCH 合成结果"
